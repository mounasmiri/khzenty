# Copy to `.env` and adjust. `.env` is git-ignored.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Origin allowed by CORS. Must match the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string. Required — the server refuses to boot without it.
# Prisma reads this too, via prisma.config.ts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khzenty?schema=public

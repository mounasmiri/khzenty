// Khzenty database schema.
//
// Covers accounts, the wardrobe and outfits.
//
// `User.passwordHash` holds an Argon2id digest and is never selected into an
// API response — the auth service projects through PUBLIC_USER_SELECT, so the
// column is absent from responses by construction rather than stripped
// afterwards.
//
// `Outfit` and `OutfitItem` are modelled but not yet exposed: there are no
// outfit endpoints. The item response carries an outfit count, which is the
// only thing currently reading them.
//
// Field-level comments carry the reasoning for anything non-obvious. Two
// invariants the database cannot express, and which therefore live in the
// service layer, are worth knowing before changing this file:
//
//   - `type` implies `category`, but both are plain enum columns. The server
//     derives the category and ignores any sent by a client, which is what
//     makes a mismatched pair unrepresentable.
//   - `imageUrl` and `imagePublicId` are written and cleared together. Losing
//     the public id orphans the Cloudinary asset behind it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Broad grouping, used for the wardrobe grid and top-level filters.
enum ClothingCategory {
  TOP
  BOTTOM
  DRESS
  OUTERWEAR
  FOOTWEAR
  ACCESSORY
  UNDERWEAR
  ACTIVEWEAR
  SLEEPWEAR
  SWIMWEAR

  /// Pairs with `ClothingType.OTHER`. Without it, the escape-hatch type has no
  /// category to derive, which would make the taxonomy map non-total.
  OTHER
}

/// The specific garment. Stored alongside `ClothingCategory` rather than
/// derived from it, so the two can be filtered independently.
///
/// A type implies a category (JEANS is always a BOTTOM), but the database
/// cannot enforce that pairing. The service layer owns that validation.
enum ClothingType {
  // TOP
  TSHIRT
  SHIRT
  BLOUSE
  SWEATER
  HOODIE
  CARDIGAN
  TANK_TOP

  // BOTTOM
  JEANS
  TROUSERS
  SHORTS
  SKIRT
  LEGGINGS

  // DRESS
  DRESS
  JUMPSUIT

  // OUTERWEAR
  JACKET
  COAT
  BLAZER
  VEST

  // FOOTWEAR
  SNEAKERS
  BOOTS
  SANDALS
  HEELS
  FLATS

  // ACCESSORY
  HAT
  SCARF
  BELT
  BAG
  JEWELRY
  SUNGLASSES
  GLOVES
  WATCH

  // UNDERWEAR
  UNDERWEAR
  BRA
  SOCKS

  // ACTIVEWEAR
  SPORTS_TOP
  SPORTS_BOTTOM

  // SLEEPWEAR
  PAJAMAS
  ROBE

  // SWIMWEAR
  SWIMSUIT

  /// Escape hatch so capture is never blocked by a missing type.
  OTHER
}

/// Whether a garment is available to wear.
///
/// An enum rather than a boolean: "in the wash" is one of several states a
/// garment can be unavailable for, and adding DRYING or NEEDS_REPAIR later is
/// then a migration rather than a redesign.
enum LaundryStatus {
  CLEAN
  IN_LAUNDRY
}

/// A garment may suit several seasons, so this is used as a list.
/// There is no ALL_SEASON member: year-round means all four are selected,
/// which keeps single-season filters correct without special cases.
enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

/// Belongs to `Outfit`, not `ClothingItem`: the same blazer is work-wear in one
/// combination and formal in another. Occasion is a property of the pairing.
enum Occasion {
  CASUAL
  WORK
  FORMAL
  SPORT
  PARTY
  TRAVEL
  HOME
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  /// Argon2id digest. Never selected into any API response — see
  /// `PUBLIC_USER_SELECT` in the auth service.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clothingItems ClothingItem[]
  outfits       Outfit[]
}

/// A single garment the user owns.
model ClothingItem {
  id String @id @default(cuid())

  /// Owner. Required — a garment with no owner has no meaning.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional so capture stays fast — a photo plus a category is enough to
  /// save. The UI falls back to the type when this is empty.
  name     String?
  category ClothingCategory
  type     ClothingType

  /// Human-readable colour name — "White", "Navy", "Olive" — not a hex value.
  /// Free text, so consistent filtering later depends on a curated picker in
  /// the UI or normalisation in the service layer.
  ///
  /// Nullable, for the same reason `name` is: a photo-first capture should not
  /// be blocked on typing a colour. Null means "not set yet" and the UI shows
  /// an Unsorted badge, which is honest where a sentinel string was not — it
  /// put a non-colour into the colour column.
  color   String?
  seasons Season[]

  /// Pins a garment to the top of the wardrobe.
  favorite Boolean @default(false)

  /// Manual, never inferred: the app has no way to know a garment is in the
  /// wash. Defaults to CLEAN so every existing garment stays wearable.
  laundryStatus LaundryStatus @default(CLEAN)

  /// When `laundryStatus` last changed, so the basket can show how long
  /// something has been sitting there. Null until the status is first set,
  /// which is why it is nullable rather than defaulting to now().
  laundryAt DateTime?

  /// Cloudinary. Both are written together by the upload flow. `imagePublicId`
  /// is the handle Cloudinary needs to delete or transform the asset; without
  /// it, removing a garment leaks its image.
  imageUrl      String?
  imagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outfitItems OutfitItem[]

  @@index([userId])
  /// The wardrobe grid filtered by category is the most common read.
  @@index([userId, category])
}

/// A named combination of garments.
model Outfit {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  occasions Occasion[]

  /// Board positions: `{ version, placements: [{ itemId, x, y, width, height }] }`
  /// in a unit coordinate space, so the board renders identically at any size.
  ///
  /// Json rather than columns because it is a presentation detail of one screen
  /// whose shape changes whenever the board gains a zone — relationally that is
  /// a migration each time. Nothing queries inside it, which is what makes Json
  /// acceptable here rather than merely convenient.
  ///
  /// The service validates the shape on the way in, so "unstructured column"
  /// does not mean "unvalidated input".
  ///
  /// Nullable: an outfit saved without positions simply gets the auto-layout.
  layout Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OutfitItem[]

  @@index([userId])
}

/// Join table for the many-to-many between `Outfit` and `ClothingItem`.
///
/// Modelled explicitly rather than as an implicit Prisma relation so it can
/// later carry per-outfit data such as layer order or canvas position.
model OutfitItem {
  /// Surrogate key, so a membership row can be addressed on its own.
  id String @id @default(cuid())

  outfitId String
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  clothingItemId String
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Still the natural key: the same garment cannot appear twice in an outfit.
  /// This also indexes `outfitId` as the leading column, which covers loading
  /// an outfit's items — no separate index needed for it.
  @@unique([outfitId, clothingItemId])
  /// Answers "which outfits use this garment?" before deleting it.
  @@index([clothingItemId])
}
